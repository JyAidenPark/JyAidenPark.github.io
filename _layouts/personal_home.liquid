---
layout: default
---

<style>
  .personal-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 230px;
    gap: 64px;
    align-items: start;
    padding: 40px 0 48px;
  }

  .hero-keywords {
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #527086;
    margin-bottom: 12px;
  }

  .hero-name {
    font-size: clamp(32px, 5vw, 54px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -1.5px;
    margin-bottom: 18px;
  }

  .hero-subtitle {
    font-size: 15px;
    color: #315d78;
    line-height: 1.7;
    margin-bottom: 28px;
  }

  .hero-bio {
    font-size: 19px;
    line-height: 1.75;
    font-weight: 400;
  }

  .hero-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
    border-radius: 5px;
    display: block;
    margin-top: 12px;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 28px;
  }

  .hero-links a {
    font-size: 14px;
    font-weight: 500;
    color: #245e80;
    text-decoration: none;
  }

  .hero-links .hero-link-pending {
    font-size: 14px;
    font-weight: 500;
    color: var(--global-text-color-light, #64748b);
  }

  .hero-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 767px) {
    .personal-hero {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 20px 0;
    }

    .hero-photo {
      max-width: 200px;
    }

    .hero-bio {
      font-size: 16px;
    }
  }

  .home-selected {
    padding: 24px 0 36px;
    border-top: 1px solid var(--global-divider-color, #e5e7eb);
  }

  .home-section-title {
    font-size: clamp(25px, 3.2vw, 32px);
    font-weight: 400;
    letter-spacing: -0.6px;
    line-height: 1.25;
    margin: 0 0 24px;
  }

  .home-cv-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px;
    padding: 32px 0 48px;
    border-top: 1px solid var(--global-divider-color, #e5e7eb);
  }

  .home-cv-column {
    min-width: 0;
  }

  .home-cv-entry {
    margin: 0 0 26px;
  }

  .home-cv-entry:last-child {
    margin-bottom: 0;
  }

  .home-cv-date {
    font-size: 13px;
    line-height: 1.5;
    color: #527086;
    margin-bottom: 5px;
  }

  .home-cv-entry-title {
    font-size: 17px;
    line-height: 1.4;
    font-weight: 500;
    margin: 0 0 4px;
  }

  .home-cv-meta,
  .home-cv-detail,
  .home-cv-empty {
    font-size: 14px;
    line-height: 1.65;
    margin: 0 0 6px;
  }

  .home-cv-detail,
  .home-cv-empty {
    color: var(--global-text-color-light, #64748b);
  }

  .home-cv-detail p {
    margin-bottom: 0;
  }

  @media (max-width: 767px) {
    .home-cv-grid {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 24px 0 36px;
    }
  }
</style>

<section class="personal-hero">

  <div class="hero-text">

    <div class="hero-keywords">
      {{ page.research_keywords }}
    </div>

    <h1 class="hero-name">
      {{ site.title }}
    </h1>

    <div class="hero-subtitle">
      {{ page.subtitle }}
    </div>

    <div class="hero-bio">
      {{ content }}
    </div>

    <div class="hero-links">
      {% for link in page.profile_links %}
        {% if link.url and link.url != '' %}
          <a href="{{ link.url | escape }}">
            {{ link.title | escape }} ↗
          </a>
        {% else %}
          <span class="hero-link-pending" aria-disabled="true">{{ link.title | escape }} ↗</span>
        {% endif %}
      {% endfor %}
    </div>

  </div>

  <div class="hero-profile">
    <img
      class="hero-photo"
      src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}"
      alt="Profile photo"
    >
  </div>

</section>

{% if page.announcements.enabled %}
  <h2>News</h2>
  {% include news.liquid limit=true %}
{% endif %}

{% if page.selected_papers %}
  <section class="home-selected" aria-labelledby="selected-publications">
    <h2 class="home-section-title" id="selected-publications">Selected Publications</h2>
    <div class="publications">
      {% bibliography --group_by none --max 4 --query @*[selected=true]* %}
    </div>
  </section>
{% endif %}

{% assign empty_entries = '' | split: ',' %}
{% assign cv_sections = site.data.cv.cv.sections %}
{% assign experience_entries = cv_sections.Experience | default: empty_entries | al_cv_sort_by_date %}
{% assign education_entries = cv_sections.Education | default: empty_entries | al_cv_sort_by_date %}
<section class="home-cv-grid" aria-label="Research experience and education">
  <div class="home-cv-column">
    <h2 class="home-section-title">Research Experience</h2>
    {% for entry in experience_entries %}
      <div class="home-cv-entry">
        {% include home_cv_dates.liquid entry=entry %}
        <h3 class="home-cv-entry-title">{{ entry.company | escape }}</h3>
        <p class="home-cv-meta">
          {{ entry.position | escape }}{% if entry.location and entry.location != '' %}{% if entry.position %} · {% endif %}{{ entry.location | escape }}{% endif %}
        </p>
        {% if entry.summary and entry.summary != '' %}
          <div class="home-cv-detail">{{ entry.summary | markdownify }}</div>
        {% endif %}
      </div>
    {% else %}
      <p class="home-cv-empty">Details to be added.</p>
    {% endfor %}
  </div>
  <div class="home-cv-column">
    <h2 class="home-section-title">Education</h2>
    {% for entry in education_entries %}
      <div class="home-cv-entry">
        {% include home_cv_dates.liquid entry=entry %}
        <h3 class="home-cv-entry-title">
          {% if entry.studyType and entry.studyType != '' %}{{ entry.studyType | escape }}{% if entry.area and entry.area != '' %} in {{ entry.area | escape }}{% endif %}{% else %}{{ entry.area | escape }}{% endif %}
        </h3>
        <p class="home-cv-meta">{{ entry.institution | escape }}</p>
        {% if entry.advisor and entry.advisor != '' %}
          <p class="home-cv-detail">Advisor: {{ entry.advisor | escape }}</p>
        {% endif %}
      </div>
    {% else %}
      <p class="home-cv-empty">Details to be added.</p>
    {% endfor %}
  </div>
</section>

